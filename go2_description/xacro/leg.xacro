<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    This leg.xacro is aligned with the reference go2_description URDF.

    Expected macro calls:
      <xacro:leg name="FL" mirror="1"  mirror_dae="True"  front_hind="1"  front_hind_dae="True"/>
      <xacro:leg name="FR" mirror="-1" mirror_dae="False" front_hind="1"  front_hind_dae="True"/>
      <xacro:leg name="RL" mirror="1"  mirror_dae="True"  front_hind="-1" front_hind_dae="False"/>
      <xacro:leg name="RR" mirror="-1" mirror_dae="False" front_hind="-1" front_hind_dae="False"/>

    Important:
      The parent link is base, not trunk.
  -->

  <xacro:include filename="$(find go2_description)/xacro/transmission.xacro"/>

  <xacro:macro name="leg" params="name mirror mirror_dae front_hind front_hind_dae">

    <joint name="${name}_hip_joint" type="revolute">
      <origin rpy="0 0 0" xyz="${0.1934 * front_hind} ${0.0465 * mirror} 0"/>
      <parent link="base"/>
      <child link="${name}_hip"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.0472" upper="1.0472" effort="23.7" velocity="30.1"/>
    </joint>

    <link name="${name}_hip">
      <inertial>
        <origin
          xyz="${-0.0054 * front_hind} ${0.00194 * mirror} -0.000105"
          rpy="0 0 0"/>
        <mass value="0.678"/>
        <inertia
          ixx="0.00048"
          ixy="${-3.01E-06 * mirror * front_hind}"
          ixz="${1.11E-06 * front_hind}"
          iyy="0.000884"
          iyz="${-1.42E-06 * mirror}"
          izz="0.000596"/>
      </inertial>

      <visual>
        <xacro:if value="${(mirror_dae == True) and (front_hind_dae == True)}">
          <origin rpy="0 0 0" xyz="0 0 0"/>
        </xacro:if>
        <xacro:if value="${(mirror_dae == False) and (front_hind_dae == True)}">
          <origin rpy="3.1415 0 0" xyz="0 0 0"/>
        </xacro:if>
        <xacro:if value="${(mirror_dae == True) and (front_hind_dae == False)}">
          <origin rpy="0 3.1415 0" xyz="0 0 0"/>
        </xacro:if>
        <xacro:if value="${(mirror_dae == False) and (front_hind_dae == False)}">
          <origin rpy="3.1415 3.1415 0" xyz="0 0 0"/>
        </xacro:if>
        <geometry>
          <mesh filename="package://go2_description/dae/hip.dae"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>

      <collision>
        <origin rpy="1.5707963267948966 0 0" xyz="0 ${0.08 * mirror} 0"/>
        <geometry>
          <cylinder length="0.04" radius="0.046"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_thigh_joint" type="revolute">
      <origin rpy="0 0 0" xyz="0 ${0.0955 * mirror} 0"/>
      <parent link="${name}_hip"/>
      <child link="${name}_thigh"/>
      <axis xyz="0 1 0"/>

      <xacro:if value="${front_hind == 1}">
        <limit lower="-1.5708" upper="3.4907" effort="23.7" velocity="30.1"/>
      </xacro:if>

      <xacro:if value="${front_hind == -1}">
        <limit lower="-0.5236" upper="4.5379" effort="23.7" velocity="30.1"/>
      </xacro:if>
    </joint>

    <link name="${name}_thigh">
      <inertial>
        <origin
          xyz="-0.00374 ${-0.0223 * mirror} -0.0327"
          rpy="0 0 0"/>
        <mass value="1.152"/>
        <inertia
          ixx="0.00584"
          ixy="${8.72E-05 * mirror}"
          ixz="-0.000289"
          iyy="0.0058"
          iyz="${0.000808 * mirror}"
          izz="0.00103"/>
      </inertial>

      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <xacro:if value="${mirror_dae == True}">
            <mesh filename="package://go2_description/dae/thigh.dae"/>
          </xacro:if>
          <xacro:if value="${mirror_dae == False}">
            <mesh filename="package://go2_description/dae/thigh_mirror.dae"/>
          </xacro:if>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>

      <collision>
        <origin rpy="0 1.5707963267948966 0" xyz="0 0 -0.1065"/>
        <geometry>
          <box size="0.213 0.0245 0.034"/>
        </geometry>
      </collision>
    </link>


    <joint name="${name}_calf_joint" type="revolute">
      <origin rpy="0 0 0" xyz="0 0 -0.213"/>
      <parent link="${name}_thigh"/>
      <child link="${name}_calf"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.7227" upper="-0.83776" effort="45.43" velocity="15.70"/>
    </joint>

    <link name="${name}_calf">
      <inertial>
        <origin
          xyz="0.00548 ${-0.000975 * mirror} -0.115"
          rpy="0 0 0"/>
        <mass value="0.154"/>
        <inertia
          ixx="0.00108"
          ixy="${3.4E-07 * mirror}"
          ixz="1.72E-05"
          iyy="0.0011"
          iyz="${8.28E-06 * mirror}"
          izz="3.29E-05"/>
      </inertial>

      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <xacro:if value="${mirror_dae == True}">
            <mesh filename="package://go2_description/dae/calf.dae"/>
          </xacro:if>
          <xacro:if value="${mirror_dae == False}">
            <mesh filename="package://go2_description/dae/calf_mirror.dae"/>
          </xacro:if>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>

      <!-- Reference URDF uses slightly different calf collision for FL. -->
      <xacro:if value="${name == 'FL'}">
        <collision>
          <origin rpy="0 -0.21 0" xyz="0.008 0 -0.06"/>
          <geometry>
            <cylinder length="0.12" radius="0.012"/>
          </geometry>
        </collision>
      </xacro:if>

      <xacro:unless value="${name == 'FL'}">
        <collision>
          <origin rpy="0 -0.2 0" xyz="0.01 0 -0.06"/>
          <geometry>
            <cylinder length="0.12" radius="0.013"/>
          </geometry>
        </collision>
      </xacro:unless>
    </link>

    <link name="${name}_calflower">
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.065" radius="0.011"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_calflower_joint" type="fixed">
      <origin xyz="0.020 0 -0.148" rpy="0 0.05 0"/>
      <parent link="${name}_calf"/>
      <child link="${name}_calflower"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="${name}_calflower1">
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.03" radius="0.0155"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_calflower1_joint" type="fixed">
      <origin xyz="-0.01 0 -0.04" rpy="0 0.48 0"/>
      <parent link="${name}_calflower"/>
      <child link="${name}_calflower1"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="${name}_foot">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.04"/>
        <inertia
          ixx="9.6e-06"
          ixy="0"
          ixz="0"
          iyy="9.6e-06"
          iyz="0"
          izz="9.6e-06"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://go2_description/dae/foot.dae"/>
        </geometry>
        <material name="">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>

      <collision>
        <origin rpy="0 0 0" xyz="-0.002 0 0"/>
        <geometry>
          <sphere radius="0.022"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_foot_joint" type="fixed" dont_collapse="true">
      <origin xyz="0 0 -0.213" rpy="0 0 0"/>
      <parent link="${name}_calf"/>
      <child link="${name}_foot"/>
      <axis xyz="0 0 0"/>
    </joint>

    <gazebo reference="${name}_hip">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
    </gazebo>

    <gazebo reference="${name}_thigh">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <self_collide>0</self_collide>
      <kp value="1000000.0"/>
      <kd value="100.0"/>
    </gazebo>

    <gazebo reference="${name}_calf">
      <mu1>0.6</mu1>
      <mu2>0.6</mu2>
      <self_collide>1</self_collide>
    </gazebo>

    <gazebo reference="${name}_foot">
      <mu1>0.6</mu1>
      <mu2>0.6</mu2>
      <self_collide>1</self_collide>
      <kp value="1000000.0"/>
      <kd value="100.0"/>
    </gazebo>

    <xacro:leg_transmission name="${name}"/>
  </xacro:macro>
</robot>
